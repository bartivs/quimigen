# Copy to /opt/quimigen/.env, set mode 0600, and replace every blank value.
QUIMIGEN_MODE=live
QUIMIGEN_STATE_FILE=/data/state.json
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Per model pass; Telegram/Exa keep their separate short deadlines.
OPENROUTER_TIMEOUT_MS=180000
TRIGGER_ENV=dev

TELEGRAM_BOT_TOKEN=
EXA_API_KEY=
OPENROUTER_API_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Trigger.dev CLI personal access token used by the long-running local dev worker.
TRIGGER_CLI_ACCESS_TOKEN=
# Optional for self-hosted Trigger.dev; leave empty for Trigger.dev Cloud.
TRIGGER_API_URL=
